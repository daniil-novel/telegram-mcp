# Obtain your own numeric application ID at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
# Application secret from the same page; never share this file.
TELEGRAM_API_HASH=
# Optional: your own phone in international format. Blank asks locally only for a new login.
TELEGRAM_PHONE=
# Optional: Telegram two-step-verification password, NOT the one-time login code.
# This is plaintext in .env; quote values with spaces or # and keep exact characters.
# Blank uses hidden terminal input when needed. A wrong configured password fails without retries.
# A valid saved session needs neither this password nor a new code; you can clear this after login.
TELEGRAM_2FA_PASSWORD=
# Default: Windows %LOCALAPPDATA%/TelegramReadOnlyMCP; POSIX ~/.local/share/telegram-readonly-mcp
# Must be outside this project. Do not put a session string in this file.
TELEGRAM_SESSION_DIR=
# '*' reads all cloud dialogs; alternatively comma-separated marked chat IDs from list_dialogs.
TELEGRAM_ALLOWED_CHAT_IDS=*
TELEGRAM_DENIED_CHAT_IDS=
# Optional writes: only literal true or false. Restart the MCP client after changing this.
TELEGRAM_WRITE_ENABLED=false
# Explicit chat IDs only; empty denies all writes. '*' is not accepted here.
# Copy marked numeric IDs (including minus signs) from list_dialogs.
TELEGRAM_WRITE_ALLOWED_CHAT_IDS=
# HTTP only: generate a random token (at least 32 characters); never use your Telegram secrets.
MCP_HTTP_TOKEN=
MCP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
